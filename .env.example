ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Optional shared secret for smoke tests / service bypass (X-API-Key / Bearer).
# Normal UI auth uses login sessions; leave empty in Docker local use.
API_KEY=

# Auth / sessions
REDIS_URL=redis://localhost:6379/0
DATABASE_PATH=./data/app.db
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
MIN_PASSWORD_LENGTH=8
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=60

# Webhooks: unsigned requests are rejected unless this is true (local only).
ALLOW_INSECURE_WEBHOOKS=false

DATA_DIR=./data
WEBHOOK_BASE_URL=http://localhost:8000
CONFIDENCE_THRESHOLD=0.7
MAX_UPLOAD_BYTES=20971520
